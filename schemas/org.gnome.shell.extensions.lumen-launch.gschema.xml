<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.lumen-launch" path="/org/gnome/shell/extensions/lumen-launch/">
    <!-- Default is Ctrl+Space (Super+Space has timing issues on some GNOME 50 setups) -->
    <key name="toggle-shortcut" type="as">
      <default>['&lt;Control&gt;space']</default>
      <summary>Toggle shortcut</summary>
      <description>Keyboard shortcut to open Lumen launch. Default is Ctrl+Space.</description>
    </key>

    <key name="popup-width" type="i">
      <default>600</default>
      <range min="400" max="1200"/>
      <summary>Popup width</summary>
      <description>Width of the Spotlight popup in pixels.</description>
    </key>

    <key name="max-results" type="i">
      <default>0</default>
      <range min="0" max="1000"/>
      <summary>Max results per category</summary>
      <description>Maximum results displayed per category. 0 means show all results.</description>
    </key>

    <key name="web-search-engine" type="s">
      <choices>
        <choice value="google"/>
        <choice value="duckduckgo"/>
        <choice value="brave"/>
        <choice value="bing"/>
        <choice value="startpage"/>
      </choices>
      <default>'google'</default>
      <summary>Web search engine</summary>
      <description>Search engine used for the web search fallback.</description>
    </key>

    <key name="show-web-search" type="b">
      <default>true</default>
      <summary>Show web search fallback</summary>
      <description>If true, a web search result is shown when no apps or settings match.</description>
    </key>

    <key name="layout-mode" type="s">
      <choices>
        <choice value="list"/>
        <choice value="grid"/>
      </choices>
      <default>'list'</default>
      <summary>Results layout</summary>
      <description>Whether results are shown as a vertical list or an icon grid (Launchpad style).</description>
    </key>

    <key name="theme" type="s">
      <choices>
        <choice value="dark"/>
        <choice value="light"/>
        <choice value="nord"/>
        <choice value="dracula"/>
        <choice value="one-dark"/>
        <choice value="solarized-light"/>
      </choices>
      <default>'dark'</default>
      <summary>Color theme</summary>
      <description>Color scheme of the popup, similar to rofi themes.</description>
    </key>
  </schema>
</schemalist>
